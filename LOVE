// События для мышки (компьютер) и касания (телефон)
noBtn.addEventListener('mouseenter', dodgeButton);
noBtn.addEventListener('touchstart', (e) => {
e.preventDefault(); // Предотвращаем клик на телефоне
dodgeButton();
});

// Функция, когда нажали "Да"
yesBtn.addEventListener('click', () => {
questionContainer.classList.add('hidden'); // Прячем вопрос
successContainer.classList.remove('hidden'); // Показываем ответ
startHearts(); // Запускаем сердечки
});

// Создание бесконечных сердечек
function startHearts() {
setInterval(createHeart, 150); // Каждые 150мс появляется новое сердце
}

function createHeart() {
const heart = document.createElement('div');
heart.classList.add('heart');
heart.innerHTML = '❤️';

// Случайная позиция по горизонтали
heart.style.left = Math.random() * 100 + 'vw';
// Случайная скорость полета (от 3 до 6 секунд)
heart.style.animationDuration = Math.random() * 3 + 3 + 's';
// Случайный размер
heart.style.fontSize = Math.random() * 20 + 20 + 'px';

document.body.appendChild(heart);

// Удаляем сердечко после того, как оно улетело, чтобы не тормозил браузер
setTimeout(() => {
heart.remove();
}, 6000);
}
</script>
</body>
</html>
